{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "possible-futures",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "percentiles.mlipman.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
