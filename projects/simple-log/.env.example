# Local/development database.
# Replace credentials and host with your development Postgres values.
DATABASE_URL="postgresql://dev_admin:YOUR_SERVER_PASSWORD@127.0.0.1:5432/simple-log?schema=public"

# Shared provider tokens. Fill from ../../.env.global when needed.
OPENAI_API_KEY=
RESEND_API_KEY=
CLOUDINARY_URL="cloudinary://API_KEY:API_SECRET@CLOUD_NAME"
