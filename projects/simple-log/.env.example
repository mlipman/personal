# next js projects read from project specific .env.local files
# expected values are listed in .env.example
# each runtime environment (eg dev computer, cloud devbox, prod verce, others)
# needs their local env set

# first time: added new simple_log db via neon console to the personal neon project
# future enhancement: automate adding a new db when new projects are made
# we chose one neon project total, one db in that per repo project, only "public" schema in each db
DATABASE_URL="postgresql://neondb_owner:npg_zzzzzzzz@ezzzz-zzzzzz.c-4.us-east-2.aws.neon.tech/simple_log?statusColor=007F3D&env=&name=neon_personal&tLSMode=0&usePrivateKey=false&safeModeLevel=0&advancedSafeModeLevel=0&driverVersion=0&lazyload=false"
# starts with sk-proj-
OPENAI_API_KEY=sk-proj-U-zzzzz-zzzzzz-zz-zzzzz
# login to cloudinary via github, from there you can view the keys to create the url
CLOUDINARY_URL=cloudinary://zzzzz:zzzzzzzz@dllptigzk

# Strong, unique password typed into the Simple Log login page.
SIMPLE_LOG_PASSWORD=replace-with-your-password
# Generate with: node scripts/generate-session-secret.mjs
SIMPLE_LOG_SESSION_SECRET=replace-with-at-least-32-random-bytes-in-base64url
